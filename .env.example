# Copy to .env before `docker compose up`. These are throwaway demo values for a local container, never real credentials.

# SA password for the SQL Server container. SQL Server requires 8+ characters from 3 of: upper, lower, digit, symbol.
MSSQL_SA_PASSWORD=Demo_Only_Passw0rd!

# The worker stops after one sync and reconciliation when true (exit code 0 = clean, 2 = differences). CI sets this.
WORKER_RUN_ONCE=false

# Fictional POS fault injection: every Nth request answers 503 (0 = never), each page repeats the last N sales.
FAKEPOS_FAILURE_EVERY=7
FAKEPOS_REDELIVER=3
FAKEPOS_TOTAL=200

# Launch guards on the fake POS's simulated terminals (defaults in src/PosIntegration.FakePos/appsettings.json, ADR 6).
# Every terminal requires scanned lines when true; T-02 always does. 0 turns the repeated-basket check off.
FAKEPOS_REQUIRE_SCAN=false
FAKEPOS_REPEAT_WINDOW_SECONDS=30
