{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LaunchGuards": {
    "Supervisors": [ "SUP-01" ],
    "Default": {
      "RequireOpenSession": true,
      "RequireDrawerClosed": true,
      "RequiredKeylock": "Normal",
      "RequireKnownItem": true,
      "RequireScan": false,
      "ConfirmQuantityAbove": 10,
      "SupervisorQuantityAbove": 50,
      "RepeatWindowSeconds": 30
    },
    "Terminals": {
      "T-02": { "RequireScan": true }
    }
  }
}
